rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupData) {
      return isSignedIn() && request.auth.uid in groupData.memberIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn()
        && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(resource.data);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.memberIds;
      // Fields only the group's admin (its creator) may change. The UI already
      // hides Edit Group and member removal from everyone else, but the rules
      // let any member rename the group, swap its photo, rotate the invite code,
      // drop other members, or flip useSimplifiedDebts — which silently changes
      // how much every member is asked to pay.
      function adminOnlyKeys() {
        return ['name', 'description', 'photoURL', 'useSimplifiedDebts', 'inviteCode', 'memberIds'];
      }
      function touchesAdminOnlyFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(adminOnlyKeys());
      }
      // A member may edit their own entry in `members`, and nothing else in it.
      function membersEditIsSelfOnly() {
        return request.resource.data.get('members', {})
                 .diff(resource.data.get('members', {}))
                 .affectedKeys().hasOnly([request.auth.uid]);
      }

      allow update: if (isGroupAdmin(groupId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt)
        // Members keep self-service writes only: their own profile entry in
        // `members` plus any field not on the admin-only list.
        || (isGroupMember(resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && !touchesAdminOnlyFields()
          && membersEditIsSelfOnly())
        // A non-member adding themselves via an invite link. Previously this
        // branch checked only that the member list grew by one and included the
        // caller, so the same write could rename the group, replace its photo,
        // flip its settings, drop other members or overwrite their profiles.
        // It is now narrowed to exactly "append myself, write my own entry".
        || (isSignedIn()
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.get('members', {})
               .diff(resource.data.get('members', {}))
               .affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      match /expenses/{expenseId} {
        allow read: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow create: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data)
          && request.auth.uid == request.resource.data.createdBy;
        allow update: if isGroupAdmin(groupId);
        allow delete: if isGroupAdmin(groupId);
      }

      match /settlements/{settlementId} {
        // Legacy documents predate these fields; fall back so old records stay
        // readable and approvable.
        function creatorUid() {
          return resource.data.get('createdBy', resource.data.fromUid);
        }
        function currentStatus() {
          return resource.data.get('status', 'approved');
        }

        allow read: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);

        function newSettlement() {
          return request.resource.data;
        }
        function transferData(transferId) {
          return get(/databases/$(database)/documents/transfers/$(transferId)).data;
        }
        // A settlement written already-approved is only acceptable when it is
        // backed by a direct transfer that this caller received. The proof is
        // the allocation the receiver committed onto the transfer *before*
        // creating this document: this settlement's own id must appear in
        // `allocations`, naming this group and this exact amount.
        //
        // That is what lets one payment settle several groups without letting
        // the same rupees be counted twice — each leg is pinned to its own
        // settlement id, and the transfer's `allocatedAmount` can never exceed
        // the payment. Checking `t.amount == amount` instead, as this used to,
        // forced every booking to consume the whole transfer, so a payment
        // bigger than one group's debt had to overshoot it.
        //
        // Rules see only pre-batch state, which is why the plan is a separate
        // earlier write rather than part of the same batch.
        function backedByMyTransfer() {
          let t = transferData(newSettlement().transferId);
          let leg = t.get('allocations', {}).get(settlementId, {});
          return t.toUid == request.auth.uid
            && t.fromUid == newSettlement().fromUid
            && leg.get('groupId', '') == groupId
            && leg.get('amount', -1) == newSettlement().amount;
        }
        // Either party may raise a settlement: the payer claiming they paid, or
        // the payee writing off what they're owed (which is what the
        // cross-group offset flow needs). The creator is always recorded.
        //
        // The second branch is the direct-transfer path: the *receiver* books
        // money they already hold into this group. They are the party who would
        // otherwise be asked to approve it, so there is nobody left to wait for.
        allow create: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data)
          && request.auth.uid == newSettlement().createdBy
          && newSettlement().fromUid != newSettlement().toUid
          && newSettlement().amount is number
          && newSettlement().amount > 0
          && (
            (
              (request.auth.uid == newSettlement().fromUid
                || request.auth.uid == newSettlement().toUid)
              && newSettlement().status == 'pending'
              && newSettlement().get('kind', 'payment') != 'transfer'
            )
            || (
              newSettlement().get('kind', '') == 'transfer'
              && request.auth.uid == newSettlement().toUid
              && newSettlement().status == 'approved'
              && newSettlement().transferId is string
              && newSettlement().fromUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
              && backedByMyTransfer()
            )
          );

        // Only the *other* party can approve or decline, and only the status
        // may change. This is what stops someone from unilaterally clearing a
        // balance they created.
        allow update: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data)
          && request.auth.uid != creatorUid()
          && (request.auth.uid == resource.data.fromUid
              || request.auth.uid == resource.data.toUid)
          && currentStatus() == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['approved', 'rejected'];

        allow delete: if false;
      }
    }

    // ── Direct person-to-person transfers ──────────────────────────────────
    // A transfer is the sender's claim that money moved. Only the receiver can
    // decide what it becomes, which is the same rule that governs group
    // settlements: whoever benefits from a balance moving never gets to move it.
    match /transfers/{transferId} {
      function newTransfer() {
        return request.resource.data;
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.auth.uid == newTransfer().fromUid
        && request.auth.uid == newTransfer().createdBy
        && newTransfer().fromUid != newTransfer().toUid
        // `participants` is what both sides query on, so it has to be exactly
        // the two people named on the transfer and nobody else.
        && newTransfer().participants.hasOnly([newTransfer().fromUid, newTransfer().toUid])
        && newTransfer().participants.hasAll([newTransfer().fromUid, newTransfer().toUid])
        && newTransfer().amount is number
        && newTransfer().amount > 0
        && newTransfer().status == 'pending'
        && !('appliedGroupId' in newTransfer())
        && !('allocations' in newTransfer())
        && !('allocatedAmount' in newTransfer());

      function currentStatus() {
        return resource.data.get('status', 'pending');
      }

      // The receiver confirms, declines, or books it into groups.
      //
      // Booking is no longer one-shot: a payment can cover debts in several
      // groups, and one that exceeds the first group's balance must be able to
      // put the rest somewhere else (or nowhere) instead of overshooting. So
      // `allocations` grows over time, under three guards:
      //
      //   - keys are append-only. Dropping one would strand the settlement
      //     document behind it.
      //   - existing entries are immutable. Rewriting a booked leg downwards
      //     would free up headroom to spend again while its settlement stands.
      //   - `allocatedAmount` only ever rises, and never past the payment.
      //
      // What these do NOT enforce is that `allocatedAmount` equals the sum of
      // `allocations`: rules cannot iterate a map, so a single write could still
      // add entries totalling more than the payment. That is deliberately
      // accepted rather than papered over. A settlement moves the balance from
      // the payer towards the payee, so the only party over-allocation can hurt
      // is the receiver who performs it — they would be writing off more of the
      // sender's debt than they were actually paid. Every other trust boundary
      // (who may create a leg, for which group, at which amount) is enforced
      // above in `backedByMyTransfer`. `scripts/audit-balances.mjs` reconciles
      // the sum against the legs and reports any drift.
      //
      // Accepting without naming a group stays valid — take the money today,
      // decide next week which group it settles. 'declined' and 'cancelled' are
      // terminal, and a declined payment may not carry allocations at all.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.toUid
        && changedKeys().hasOnly(['status', 'updatedAt', 'appliedGroupId', 'appliedSettlementId', 'allocations', 'allocatedAmount'])
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.get('allocatedAmount', 0) is number
        && request.resource.data.get('allocatedAmount', 0) >= resource.data.get('allocatedAmount', 0)
        && request.resource.data.get('allocatedAmount', 0) <= resource.data.amount
        && request.resource.data.get('allocations', {}).keys().hasAll(
             resource.data.get('allocations', {}).keys())
        && request.resource.data.get('allocations', {})
             .diff(resource.data.get('allocations', {})).changedKeys().hasOnly([])
        && (request.resource.data.get('allocations', {}).size() == 0
            || request.resource.data.status == 'accepted')
        && (
          (currentStatus() == 'pending' && request.resource.data.status in ['accepted', 'declined'])
          || (currentStatus() == 'accepted' && request.resource.data.status == 'accepted')
        );

      // The sender withdrawing a claim they raised by mistake, and nothing else.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.fromUid
        && currentStatus() == 'pending'
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled';

      // History of who paid whom is never removable.
      allow delete: if false;
    }

    // ── Two-person chat threads ───────────────────────────────────────────
    match /threads/{threadId} {
      function participantsOf(data) {
        return data.participants;
      }
      function isParticipant(data) {
        return isSignedIn() && request.auth.uid in participantsOf(data);
      }

      allow read: if isParticipant(resource.data);

      allow create: if isSignedIn()
        && request.auth.uid in participantsOf(request.resource.data)
        && participantsOf(request.resource.data).size() == 2
        // The id is derived from the pair, so an attacker can't attach a thread
        // between two other people to an id they control.
        && threadId == participantsOf(request.resource.data)[0] + '_' + participantsOf(request.resource.data)[1];

      // Participants may update the preview and their own read marker; the pair
      // itself is immutable, so a thread can never gain a third reader.
      allow update: if isParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        function thread() {
          return get(/databases/$(database)/documents/threads/$(threadId)).data;
        }

        allow read: if isSignedIn() && request.auth.uid in thread().participants;

        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.fromUid
          && request.auth.uid in thread().participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is number;

        // Sent is sent: nobody edits or deletes what they said, on either side.
        allow update, delete: if false;
      }
    }
  }
}
